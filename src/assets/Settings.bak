.settings-container {
  padding: 40px;
  background-color: #fff;
  min-height: 100vh;
  font-family: 'Poppins', sans-serif;
  color: #333;
  max-width: 900px;
  margin-left: 250px; /* closer to sidebar */
}

.settings-container h2 {
  font-size: 26px;
  margin-bottom: 30px;
  font-weight: 600;
}

.settings-section {
  margin-bottom: 40px;
}

.settings-section h3 {
  font-size: 18px;
  margin-bottom: 15px;
  font-weight: 600;
}

.settings-section p {
  font-size: 14px;
  color: #555;
}

.highlight {
  font-weight: 600;
}

.link-btn {
  margin-left: 8px;
  background: none;
  border: none;
  color: #3b49df;
  font-size: 14px;
  cursor: pointer;
}

.link-btn:hover {
  text-decoration: underline;
}

.profile-pic-container {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 15px;
}

.profile-pic {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid #ccc;
}

.upload-btn {
  background-color: #3b49df;
  color: white;
  padding: 8px 14px;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  display: inline-block;
}

.upload-btn:hover {
  background-color: #2a36b1;
}

.password-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.small-text {
  font-size: 12px;
  margin-top: 5px;
}

.small-text a {
  color: #3b49df;
  text-decoration: none;
}

.small-text a:hover {
  text-decoration: underline;
}

.primary-btn {
  padding: 10px 20px;
  background-color: #3b49df;
  color: white;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  font-weight: 600;
  margin-top: 10px;
}

.primary-btn:hover {
  background-color: #2a36b1;
}

.danger-link {
  background: none;
  border: none;
  color: #d9534f;
  font-size: 14px;
  cursor: pointer;
  padding: 0;
}

.danger-link:hover {
  text-decoration: underline;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: white;
  padding: 20px;
  border-radius: 10px;
  width: 350px;
  max-width: 90%;
  text-align: center;
}

.modal-content input {
  width: 100%;
  padding: 8px;
  margin: 10px 0;
}

.modal-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 15px;
}

.primary-btn {
  background: #4CAF50;
  color: white;
  border: none;
  padding: 8px 15px;
  border-radius: 5px;
  cursor: pointer;
}

.secondary-btn {
  background: #ddd;
  border: none;
  padding: 8px 15px;
  border-radius: 5px;
  cursor: pointer;
}

.danger-link {
  background: red;
  color: white;
  border: none;
  padding: 8px 15px;
  border-radius: 5px;
  cursor: pointer;
}
/* Modal overlay */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

/* Modal content box */
.modal-content {
  background: #fff;
  padding: 20px;
  border-radius: 8px;
  width: 300px;
  max-width: 90%;
  text-align: center;
}

/* Modal actions (buttons) */
.modal-actions {
  margin-top: 15px;
  display: flex;
  justify-content: space-around;
}

/* Primary button inside modal */
.modal .primary-btn {
  background-color: #4CAF50;
  color: white;
  border: none;
  padding: 8px 15px;
  border-radius: 4px;
  cursor: pointer;
}

/* Secondary button inside modal */
.modal .secondary-btn {
  background-color: #ccc;
  color: #333;
  border: none;
  padding: 8px 15px;
  border-radius: 4px;
  cursor: pointer;
}

/* Optional: input styling inside modal */
.modal input {
  width: 100%;
  padding: 8px;
  margin-top: 10px;
  border-radius: 4px;
  border: 1px solid #ccc;
}

